+    assert_eq!(s.hint().as_deref(), Some("e2"));
+    assert_eq!(s.hint().as_deref(), Some("e2"));
+    assert_eq!(s.hints, 1);
+    assert_eq!(fen(&s.position), before);
+    assert_eq!(s.cursor, 0);
+    s.play("e2e4").unwrap();
+    assert!(!s.clean());
+}
+#[test]
+fn revealed_is_never_clean() {
+    let mut s = custom(START, &["e2e4", "e7e5", "g1f3"]);
+    s.reveal();
+    assert!(s.complete());
+    assert!(s.revealed);
+    assert!(!s.clean());

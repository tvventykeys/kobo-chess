+#[test]
+fn multistep_with_deterministic_reply() {
+    let mut s = custom(START, &["e2e4", "e7e5", "g1f3"]);
+    assert_eq!(s.play("e2e4").unwrap(), Played::Correct);
+    assert_eq!(s.cursor, 2);
+    assert!(s.position.board().piece_at(Square::E5).is_some());

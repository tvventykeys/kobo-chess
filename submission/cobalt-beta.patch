+    }
+}
+#[test]
+fn pack_rejects_unknown_schema() {
+    assert!(
+        Pack::parse(pack::BUILTIN.replacen("\"schema_version\":1", "\"schema_version\":2", 1))
+            .is_err()
+    );
+}
+#[test]
+fn pack_rejects_illegal_line() {

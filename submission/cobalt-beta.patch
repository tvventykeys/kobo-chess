diff --git a/apps/polgar-pocket/Cargo.toml b/apps/polgar-pocket/Cargo.toml
new file mode 100644
index 0000000000000000000000000000000000000000..a262326978308f98c83554f5d8d5c32a2ce6fb2f
--- /dev/null
+++ b/apps/polgar-pocket/Cargo.toml
@@ -0,0 +1,21 @@
+[package]
+name = "kobo-polgar-pocket"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish = false
+
+[dependencies]
+kobo-sdk = { path = "../../crates/kobo-sdk" }
+shakmaty = "=0.27.3"
+serde = { version = "=1.0.229", features = ["derive"] }
+serde_json = "=1.0.151"
+
+[dev-dependencies]
+kobo-ui = { path = "../../crates/kobo-ui" }
+kobo-text = { path = "../../crates/kobo-text" }
+kobo-profile = { path = "../../crates/kobo-profile" }
+
+[lints]
+workspace = true

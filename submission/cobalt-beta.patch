+    let p = rules::position("7k/P7/8/8/8/8/8/7K w - - 0 1").unwrap();
+    assert!(rules::movement(&p, "a7a8").is_err());
+    for role in ['q', 'r', 'b', 'n'] {
+        assert!(rules::movement(&p, &format!("a7a8{role}")).is_ok());
+    }

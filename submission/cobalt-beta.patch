+    s.play("e2e4").unwrap();
+    assert!(!s.clean());
+}
+#[test]
+fn illegal_move_cannot_advance() {
+    let mut s = custom(START, &["e2e4"]);
+    assert!(s.play("e2e6").is_err());
+    assert_eq!(s.cursor, 0);

new file mode 100644
index 0000000000000000000000000000000000000000..df6255518f5e9ec16c5be70d672c3cc0b99c805f
--- /dev/null
+++ b/apps/polgar-pocket/src/rules.rs
@@ -0,0 +1,30 @@
+//! Full standard-chess legality comes from shakmaty, as in Cobalt Lichess.
+use shakmaty::{fen::Fen, uci::UciMove, CastlingMode, Chess, Position};
+
+pub fn position(fen: &str) -> Result<Chess, String> {
+    fen.parse::<Fen>()
+        .map_err(|e| format!("Invalid FEN: {e}"))?
+        .into_position(CastlingMode::Standard)
+        .map_err(|e| format!("Invalid position: {e}"))
+}
+
+pub fn movement(pos: &Chess, uci: &str) -> Result<shakmaty::Move, String> {
+    UciMove::from_ascii(uci.as_bytes())
+        .map_err(|_| "Malformed UCI".to_owned())?
+        .to_move(pos)
+        .map_err(|_| "Illegal move".to_owned())
+}
+
+pub fn play(pos: &mut Chess, uci: &str) -> Result<(), String> {
+    let movement = movement(pos, uci)?;
+    pos.play_unchecked(&movement);
+    Ok(())
+}
+
+pub fn legal_from(pos: &Chess, from: &str) -> Vec<String> {
+    pos.legal_moves()
+        .iter()
+        .map(|m| m.to_uci(CastlingMode::Standard).to_string())
+        .filter(|m| m.starts_with(from))
+        .collect()
+}
diff --git a/apps/polgar-pocket/src/session.rs b/apps/polgar-pocket/src/session.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bfd37acafc9d8a82afb2ff67ece362cca9cc0643
--- /dev/null
+++ b/apps/polgar-pocket/src/session.rs
@@ -0,0 +1,96 @@
+use crate::{pack::Puzzle, rules};
+use shakmaty::Chess;
+
+#[derive(Clone)]
+pub struct Session {
+    pub puzzle: Puzzle,
+    pub position: Chess,
+    pub cursor: usize,
+    pub wrong: u32,
+    pub hints: u32,
+    pub revealed: bool,
+}
+#[derive(Debug, PartialEq, Eq)]
+pub enum Played {
+    Wrong,
+    Correct,
+    Complete,
+}
+impl Session {
+    pub fn new(puzzle: Puzzle) -> Self {
+        let position = rules::position(&puzzle.fen).expect("validated puzzle");
+        Self {
+            puzzle,
+            position,
+            cursor: 0,
+            wrong: 0,
+            hints: 0,
+            revealed: false,
+        }
+    }
+    pub fn complete(&self) -> bool {
+        self.cursor == self.puzzle.solution.len()
+    }
+    pub fn active(&self) -> bool {
+        !self.complete() && (self.cursor > 0 || self.wrong > 0 || self.hints > 0)
+    }
+    pub fn clean(&self) -> bool {
+        self.complete() && self.wrong == 0 && self.hints == 0 && !self.revealed
+    }
+    pub fn play(&mut self, uci: &str) -> Result<Played, String> {
+        if self.complete() {
+            return Err("Exercise finished; Retry to study again".into());
+        }
+        rules::movement(&self.position, uci)?;
+        if self.puzzle.solution[self.cursor] != uci {
+            self.wrong = self.wrong.saturating_add(1);
+            return Ok(Played::Wrong);
+        }
+        rules::play(&mut self.position, uci)?;
+        self.cursor += 1;
+        if !self.complete() {
+            rules::play(&mut self.position, &self.puzzle.solution[self.cursor])?;
+            self.cursor += 1;
+        }
+        Ok(if self.complete() {
+            Played::Complete
+        } else {
+            Played::Correct
+        })
+    }
+    pub fn hint(&mut self) -> Option<String> {
+        if self.complete() {
+            return None;
+        }
+        // One hint level, one charge per attempt. Only the source is exposed.
+        self.hints = 1;
+        Some(self.puzzle.solution[self.cursor][..2].to_owned())
+    }
+    pub fn reveal(&mut self) {
+        if self.complete() {
+            return;
+        }
+        self.revealed = true;
+        while !self.complete() {
+            rules::play(&mut self.position, &self.puzzle.solution[self.cursor])
+                .expect("validated line");
+            self.cursor += 1;
+        }
+    }
+    pub fn solution_text(&self) -> String {
+        let mut position = rules::position(&self.puzzle.fen).expect("validated puzzle");
+        self.puzzle
+            .solution
+            .iter()
+            .map(|uci| {
+                let movement = rules::movement(&position, uci).expect("validated line");
+                shakmaty::san::SanPlus::from_move_and_play_unchecked(&mut position, &movement)
+                    .to_string()
+            })
+            .collect::<Vec<_>>()
+            .join(" ")
+    }
+    pub fn retry(&mut self) {
+        *self = Self::new(self.puzzle.clone());
+    }
+}

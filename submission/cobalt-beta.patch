+#[test]
+fn pending_saves_coalesce_and_block_suspend() {
+    let (mut p, mut cx) = app();
+    p.start(&mut cx, 0);
+    assert!(!p.can_suspend());
+    action(&mut p, &mut cx, "hint");
+    assert!(p.dirty);
+    p.on_save(&mut cx, KEY, StoreResult::Saved { key: KEY.into() });
+    assert!(p.saving);

diff --git a/apps/polgar-pocket/src/board.rs b/apps/polgar-pocket/src/board.rs
new file mode 100644
index 00000000..bbff32f0
--- /dev/null
+++ b/apps/polgar-pocket/src/board.rs
@@ -0,0 +1,67 @@
+use crate::rules;
+use kobo_sdk::{action_id, ActionId, Glyph};
+use shakmaty::{Chess, Color, Position, Role, Square};
+
+pub fn square_action(action: ActionId) -> Option<String> {
+    Square::ALL
+        .into_iter()
+        .map(|s| s.to_string())
+        .find(|s| action == action_id(&format!("square-{s}")))
+}
+pub fn cells(
+    pos: &Chess,
+    black: bool,
+    selected: Option<&str>,
+    hint: Option<&str>,
+    coordinates: bool,
+) -> Vec<(String, String, Option<Glyph>, bool)> {
+    let legal = selected
+        .map(|s| rules::legal_from(pos, s))
+        .unwrap_or_default();
+    let checked = pos
+        .is_check()
+        .then(|| pos.board().king_of(pos.turn()))
+        .flatten();
+    let mut cells = Vec::with_capacity(64);
+    for row in 0..8 {
+        for col in 0..8 {
+            let file = if black { 7 - col } else { col };
+            let rank = if black { row } else { 7 - row };
+            let sq = Square::from_coords(shakmaty::File::new(file), shakmaty::Rank::new(rank));
+            let name = sq.to_string();
+            let piece = pos.board().piece_at(sq);
+            let destination = legal.iter().any(|m| m[2..4] == name);
+            let glyph = piece
+                .map(|p| piece_glyph(p.color, p.role))
+                .or_else(|| destination.then_some(Glyph::LegalPoint));
+            let marked = selected == Some(name.as_str())
+                || hint == Some(name.as_str())
+                || checked == Some(sq)
+                || (destination && piece.is_some());
+            // Coordinate is also the accessible name, even when a glyph draws it.
+            let label = if glyph.is_some() || coordinates {
+                name.clone()
+            } else {
+                " ".into()
+            };
+            cells.push((format!("square-{name}"), label, glyph, marked));
+        }
+    }
+    cells
+}
+fn piece_glyph(color: Color, role: Role) -> Glyph {
+    match (color, role) {
+        (Color::White, Role::King) => Glyph::ChessWhiteKing,
+        (Color::White, Role::Queen) => Glyph::ChessWhiteQueen,
+        (Color::White, Role::Rook) => Glyph::ChessWhiteRook,
+        (Color::White, Role::Bishop) => Glyph::ChessWhiteBishop,
+        (Color::White, Role::Knight) => Glyph::ChessWhiteKnight,
+        (Color::White, Role::Pawn) => Glyph::ChessWhitePawn,
+        (Color::Black, Role::King) => Glyph::ChessBlackKing,
+        (Color::Black, Role::Queen) => Glyph::ChessBlackQueen,
+        (Color::Black, Role::Rook) => Glyph::ChessBlackRook,
+        (Color::Black, Role::Bishop) => Glyph::ChessBlackBishop,
+        (Color::Black, Role::Knight) => Glyph::ChessBlackKnight,
+        (Color::Black, Role::Pawn) => Glyph::ChessBlackPawn,
+    }
+}
diff --git a/apps/polgar-pocket/src/import.rs b/apps/polgar-pocket/src/import.rs
new file mode 100644
index 00000000..8966b7ed
--- /dev/null
+++ b/apps/polgar-pocket/src/import.rs
@@ -0,0 +1,146 @@
+//! Offline conversion of explicit, selected Lichess exports. No database/network access.
+use crate::{
+    pack::{Header, Pack, Puzzle},
+    rules,
+};
+use serde::Deserialize;
+use shakmaty::{fen::Fen, EnPassantMode, Position};
+
+#[derive(Deserialize)]
+pub struct LichessRow {
+    #[serde(rename = "puzzleId")]
+    pub id: String,
+    pub fen: String,
+    pub moves: String,
+    pub rating: u32,
+    pub themes: Vec<String>,
+    #[serde(rename = "gameUrl")]
+    pub game_url: Option<String>,
+}
+
+pub fn lichess(bytes: &[u8]) -> Result<String, String> {
+    if bytes.len() > 4 * 1024 * 1024 {
+        return Err("Export too large; select a smaller subset".into());
+    }
+    let rows: Vec<LichessRow> = serde_json::from_slice(bytes).map_err(|e| e.to_string())?;
+    if rows.is_empty() || rows.len() > 4096 {
+        return Err("Expected 1–4096 selected puzzles".into());
+    }
+    let header = Header {
+        schema_version: 1,
+        collection_id: "lichess-tactics".into(),
+        title: "Lichess · Selected study".into(),
+        source: "https://database.lichess.org/#puzzles".into(),
+        license: "CC0-1.0".into(),
+    };
+    let mut output = serde_json::to_string(&header).map_err(|e| e.to_string())? + "\n";
+    for row in rows {
+        let moves: Vec<_> = row.moves.split_whitespace().collect();
+        let Some((setup, line)) = moves.split_first() else {
+            return Err("Missing setup move".into());
+        };
+        let mut position = rules::position(&row.fen)?;
+        rules::play(&mut position, setup)?;
+        let puzzle = Puzzle {
+            id: row.id,
+            fen: Fen::from_position(position.clone(), EnPassantMode::Legal).to_string(),
+            side_to_move: if position.turn().is_white() {
+                "white"
+            } else {
+                "black"
+            }
+            .into(),
+            solution: line.iter().copied().map(str::to_owned).collect(),
+            explanation: String::new(),
+            difficulty: Some(row.rating),
+            tags: row.themes,
+            source_url: row.game_url,
+        };
+        puzzle.validate()?;
+        output.push_str(&serde_json::to_string(&puzzle).map_err(|e| e.to_string())?);
+        output.push('\n');
+    }
+    Pack::parse(output.clone())?;
+    Ok(output)
+}
+
+#[derive(Deserialize)]
+struct BookExport {
+    #[serde(rename = "bookId")]
+    id: String,
+    #[serde(rename = "bookTitle")]
+    title: String,
+    problems: Vec<BookProblem>,
+}
+#[derive(Deserialize)]
+struct BookProblem {
+    problemid: u32,
+    fen: String,
+    moves: String,
+    #[serde(default)]
+    explanation: String,
+    #[serde(default)]
+    difficulty: Option<u32>,
+}
+/// Only the inspected interactive `problems` format. Positional/self-assessed
+/// books and inferred/engine-generated continuations are intentionally excluded.
+pub fn trainer(bytes: &[u8], ids: &[u32]) -> Result<String, String> {
+    if bytes.len() > 4 * 1024 * 1024 || ids.is_empty() || ids.len() > 100 {
+        return Err("Select 1–100 problem IDs from an export no larger than 4 MiB".into());
+    }
+    let book: BookExport = serde_json::from_slice(bytes).map_err(|e| e.to_string())?;
+    let header = Header {
+        schema_version: 1,
+        collection_id: book.id,
+        title: book.title,
+        source: "Selected local trainer export".into(),
+        license: "Private; not for redistribution".into(),
+    };
+    let mut out = serde_json::to_string(&header).map_err(|e| e.to_string())? + "\n";
+    for id in ids {
+        let matches: Vec<_> = book
+            .problems
+            .iter()
+            .filter(|p| p.problemid == *id)
+            .collect();
+        if matches.len() != 1 {
+            return Err(format!("Problem {id} missing or duplicated"));
+        }
+        let row = matches[0];
+        let pos = rules::position(&row.fen)?;
+        let solution: Vec<String> = row
+            .moves
+            .split(';')
+            .map(str::trim)
+            .filter(|m| !m.is_empty())
+            .map(|m| m.replace('-', "").to_ascii_lowercase())
+            .collect();
+        let puzzle = Puzzle {
+            id: id.to_string(),
+            fen: row.fen.clone(),
+            side_to_move: if pos.turn().is_white() {
+                "white"
+            } else {
+                "black"
+            }
+            .into(),
+            solution,
+            explanation: row.explanation.clone(),
+            difficulty: row.difficulty,
+            tags: vec![],
+            source_url: None,
+        };
+        puzzle.validate()?;
+        let mut final_position = pos;
+        for m in &puzzle.solution {
+            rules::play(&mut final_position, m)?;
+        }
+        if !final_position.is_checkmate() {
+            return Err(format!("Problem {id} does not end in checkmate"));
+        }
+        out.push_str(&serde_json::to_string(&puzzle).map_err(|e| e.to_string())?);
+        out.push('\n');
+    }
+    Pack::parse(out.clone())?;
+    Ok(out)
+}
diff --git a/apps/polgar-pocket/src/main.rs b/apps/polgar-pocket/src/main.rs
new file mode 100644
index 00000000..92bf26ec
--- /dev/null
+++ b/apps/polgar-pocket/src/main.rs
@@ -0,0 +1,686 @@
+mod board;
+mod import;
+mod pack;
+mod progress;
+mod rules;
+mod session;
+#[cfg(test)]
+mod tests;
+
+use crate::{
+    pack::Pack,
+    progress::Progress,
+    session::{Played, Session},
+};
+use kobo_sdk::{action_id, ActionId, Context, KoboApp, Screen, ScreenBuilder, StoreResult};
+use shakmaty::{Position, Square};
+
+const KEY: &str = "pocket.progress.v1";
+#[derive(Clone, Copy, PartialEq)]
+enum Page {
+    Home,
+    Collections,
+    Study,
+    Settings,
+}
+#[derive(Clone, Copy)]
+enum Leave {
+    Index(usize),
+    Home,
+}
+#[allow(
+    clippy::struct_excessive_bools,
+    reason = "UI selection and independent runtime storage acknowledgements are separate flags"
+)]
+struct Pocket {
+    pack: Pack,
+    progress: Progress,
+    session: Option<Session>,
+    page: Page,
+    selected: Option<String>,
+    hint: Option<String>,
+    promotion: Option<String>,
+    leave: Option<Leave>,
+    feedback: String,
+    storage_notice: Option<String>,
+    storage_open: bool,
+    ready: bool,
+    writable: bool,
+    dirty: bool,
+    saving: bool,
+    storage_waiver: bool,
+    exit_requested: bool,
+    last_screen: Option<Screen>,
+}
+impl Pocket {
+    fn new(pack: Pack) -> Self {
+        let progress = Progress::new(&pack);
+        Self {
+            pack,
+            progress,
+            session: None,
+            page: Page::Home,
+            selected: None,
+            hint: None,
+            promotion: None,
+            leave: None,
+            feedback: String::new(),
+            storage_notice: None,
+            storage_open: false,
+            ready: false,
+            writable: true,
+            dirty: false,
+            saving: false,
+            storage_waiver: false,
+            exit_requested: false,
+            last_screen: None,
+        }
+    }
+    fn show(&mut self, cx: &mut Context) {
+        let screen = self.screen();
+        if self.last_screen.as_ref() != Some(&screen) {
+            self.last_screen = Some(screen.clone());
+            cx.set_screen(screen);
+        }
+    }
+    fn request_exit(&mut self, cx: &mut Context) {
+        if !self.dirty && !self.saving {
+            cx.exit();
+        } else {
+            self.exit_requested = true;
+            self.flush(cx);
+        }
+    }
+    #[allow(
+        clippy::too_many_lines,
+        reason = "Keep one declarative screen description for the related study controls"
+    )]
+    fn screen(&self) -> Screen {
+        let mut b = ScreenBuilder::new("polgar-pocket")
+            .top_bar("Polgár Pocket")
+            .owns_back(true);
+        if !self.ready {
+            return b.heading("Opening your study book…").build();
+        }
+        if self.exit_requested {
+            let mut exit = b.heading("Leaving your study book");
+            if self.storage_notice.is_some() {
+                exit =
+                    exit.text("Progress could not be saved. Exit loses changes from this session.");
+                if self.writable {
+                    exit = exit.button("save-progress", "Retry save");
+                }
+                exit = exit.button("exit-unsaved", "Exit without saving");
+            } else {
+                exit = exit.text("Saving progress before exit…");
+            }
+            return exit.button("cancel-exit", "Keep studying").build();
+        }
+        match self.page {
+            Page::Home => {
+                let completed = self
+                    .progress
+                    .records
+                    .values()
+                    .filter(|r| r.completed)
+                    .count();
+                let clean = self
+                    .progress
+                    .records
+                    .values()
+                    .filter(|r| r.clean_solves > 0)
+                    .count();
+                b = b
+                    .heading("Polgár Trainer Pocket")
+                    .secondary("A quiet chess puzzle book. Entirely offline.")
+                    .section("Your collection")
+                    .button("collections", &self.pack.header.title)
+                    .text(format!(
+                        "{completed} / {} solved · {clean} clean",
+                        self.pack.len()
+                    ))
+                    .primary_button("continue", "Continue studying")
+                    .button("settings", "Settings")
+                    .button("exit", "Exit to launcher");
+            }
+            Page::Collections => {
+                b = b
+                    .heading("Study collections")
+                    .button("select-pack", &self.pack.header.title)
+                    .secondary(format!(
+                        "{} verified puzzles · {}",
+                        self.pack.len(),
+                        self.pack.header.license
+                    ))
+                    .text("Selected for offline study. Original Lichess puzzle IDs are preserved.")
+                    .button("home", "Home");
+            }
+            Page::Settings => {
+                b=b.heading("Study settings")
+                    .toggle("flip","Flip board","By default your side is at the bottom.",self.progress.flipped)
+                    .toggle("coordinates", "Square coordinates", "Label empty squares with their absolute coordinates.", self.progress.coordinates)
+                    .text("Text size follows Cobalt Settings. Page buttons go to the previous or next puzzle, with confirmation during an attempt.")
+                    .secondary("No Wi-Fi, engine, timers or background tasks. Progress is stored on this reader.")
+                    .button("home","Home");
+            }
+            Page::Study => {
+                let s = self.session.as_ref().expect("study has session");
+                let black = (s.puzzle.side_to_move == "black") ^ self.progress.flipped;
+                let turn = if s.position.turn().is_white() {
+                    "White"
+                } else {
+                    "Black"
+                };
+                let state = if s.complete() {
+                    if s.revealed {
+                        "Solution revealed"
+                    } else {
+                        "Solved"
+                    }
+                } else if s.position.is_check() {
+                    "Check"
+                } else {
+                    "Find the best move"
+                };
+                b = b
+                    .top_bar_action(
+                        if s.complete() {
+                            "previous"
+                        } else {
+                            "coordinates"
+                        },
+                        if s.complete() { "Prev" } else { "Coords" },
+                    )
+                    .secondary(format!(
+                        "{} · {} / {}",
+                        self.pack.header.title,
+                        self.progress.current + 1,
+                        self.pack.len()
+                    ))
+                    .secondary(if s.complete() {
+                        format!(
+                            "{} exercise · {state}",
+                            if s.puzzle.side_to_move == "white" {
+                                "White"
+                            } else {
+                                "Black"
+                            }
+                        )
+                    } else {
+                        format!("{turn} to move · {state}")
+                    })
+                    .board_with_selection(
+                        8,
+                        board::cells(
+                            &s.position,
+                            black,
+                            self.selected.as_deref(),
+                            self.hint.as_deref(),
+                            self.progress.coordinates,
+                        ),
+                    );
+                // Coordinate display is optional to keep the board quiet.
+                let message = if self.feedback.is_empty() {
+                    if s.complete() {
+                        if s.revealed {
+                            "Solution shown. Retry to practice."
+                        } else if s.clean() {
+                            "Solved independently."
+                        } else {
+                            "Solved with assistance."
+                        }
+                    } else {
+                        "Tap a piece, then its destination."
+                    }
+                } else {
+                    &self.feedback
+                };
+                b = b.secondary(message);
+                if s.complete() && !s.puzzle.explanation.is_empty() {
+                    b = b.secondary(&s.puzzle.explanation);
+                }
+                if s.revealed {
+                    b = b.secondary(format!("Line: {}", s.solution_text()));
+                }
+                b = if s.complete() {
+                    b.buttons([("retry", "Retry"), ("home", "Home"), ("next", "Next")])
+                } else {
+                    b.buttons([("hint", "Hint"), ("retry", "Retry"), ("reveal", "Reveal")])
+                        .buttons([("previous", "Prev"), ("home", "Home"), ("next", "Next")])
+                };
+                if let Some(base) = &self.promotion {
+                    b = b.dialog("Promote pawn", "cancel", |d| {
+                        d.text(format!("Choose a piece for {base}"))
+                            .buttons([("promote-q", "Queen"), ("promote-r", "Rook")])
+                            .buttons([("promote-b", "Bishop"), ("promote-n", "Knight")])
+                            .button("cancel", "Cancel")
+                    });
+                }
+            }
+        }
+        if let Some(text) = &self.storage_notice {
+            b = b.top_bar_action("storage-open", "Storage");
+            if self.storage_open && self.leave.is_none() && self.promotion.is_none() {
+                b = b.dialog("Storage needs attention", "storage-dismiss", |d| {
+                    let d = d.text(text);
+                    let d = if self.writable && !self.storage_waiver {
+                        d.text("Allowing sleep may lose unsaved changes.").buttons([
+                            ("save-progress", "Retry save"),
+                            ("allow-sleep", "Allow sleep"),
+                        ])
+                    } else {
+                        d.button("save-progress", "Retry storage")
+                    };
+                    d.button("storage-dismiss", "Keep studying")
+                });
+            }
+        }
+        if self.leave.is_some() {
+            b = b.dialog("Leave this attempt?", "cancel", |d| {
+                d.text("History is kept. Switching puzzles starts a fresh attempt.")
+                    .buttons([("confirm-leave", "Leave"), ("cancel", "Keep studying")])
+            });
+        }
+        b.build()
+    }
+    fn save(&mut self, cx: &mut Context) {
+        self.progress.capture(self.session.as_ref());
+        self.dirty = true;
+        self.flush(cx);
+    }
+    fn flush(&mut self, cx: &mut Context) {
+        if self.ready
+            && self.writable
+            && self.dirty
+            && !self.saving
+            && self.storage_notice.is_none()
+        {
+            let bytes = serde_json::to_vec(&self.progress).expect("serializable progress");
+            cx.store().save(KEY, bytes);
+            self.saving = true;
+            self.storage_waiver = false;
+            self.dirty = false;
+        }
+    }
+    fn start(&mut self, cx: &mut Context, index: usize) {
+        self.progress.current = index;
+        let s = Session::new(self.pack.puzzle(index));
+        self.progress.begin(&s);
+        self.session = Some(s);
+        self.page = Page::Study;
+        self.clear_selection();
+        self.feedback.clear();
+        self.save(cx);
+    }
+    fn clear_selection(&mut self) {
+        self.selected = None;
+        self.hint = None;
+        self.promotion = None;
+    }
+    fn request_leave(&mut self, cx: &mut Context, target: Leave) {
+        if matches!(target, Leave::Index(_)) && self.session.as_ref().is_some_and(Session::active) {
+            self.leave = Some(target);
+        } else {
+            self.navigate(cx, target);
+        }
+    }
+    fn navigate(&mut self, cx: &mut Context, target: Leave) {
+        self.leave = None;
+        self.clear_selection();
+        match target {
+            Leave::Index(i) => self.start(cx, i),
+            Leave::Home => {
+                self.page = Page::Home;
+                self.save(cx);
+            }
+        }
+    }
+    fn move_piece(&mut self, cx: &mut Context, uci: &str) {
+        let Some(s) = self.session.as_mut() else {
+            return;
+        };
+        match s.play(uci) {
+            Err(e) => {
+                self.feedback = e;
+                return;
+            }
+            Ok(Played::Wrong) => {
+                let r = self
+                    .progress
+                    .records
+                    .get_mut(&s.puzzle.id)
+                    .expect("started attempt");
+                r.incorrect_attempts = r.incorrect_attempts.saturating_add(1);
+                self.feedback = "Legal move, but not this solution. Try again.".into();
+            }
+            Ok(Played::Correct) => self.feedback = "Correct. Opponent replied; your move.".into(),
+            Ok(Played::Complete) => {
+                self.feedback = if s.clean() {
+                    "Solved independently."
+                } else {
+                    "Solved with assistance."
+                }
+                .into();
+                self.progress.finish(s);
+            }
+        }
+        self.clear_selection();
+        self.save(cx);
+    }
+    fn tap_square(&mut self, cx: &mut Context, square: String) {
+        let Some(s) = self.session.as_ref() else {
+            return;
+        };
+        if s.complete() {
+            return;
+        }
+        let sq: Square = square.parse().expect("square action");
+        if s.position
+            .board()
+            .piece_at(sq)
+            .is_some_and(|p| p.color == s.position.turn())
+        {
+            if self.selected.as_ref() == Some(&square) {
+                self.selected = None;
+            } else {
+                self.selected = Some(square);
+            }
+            self.hint = None;
+            return;
+        }
+        let Some(from) = self.selected.clone() else {
+            return;
+        };
+        let base = format!("{from}{square}");
+        let choices = rules::legal_from(&s.position, &from);
+        if choices.iter().any(|m| m.starts_with(&base) && m.len() == 5) {
+            self.promotion = Some(base);
+            return;
+        }
+        self.move_piece(cx, &base);
+    }
+}
+impl KoboApp for Pocket {
+    fn on_start(&mut self, cx: &mut Context) {
+        cx.store().load(KEY);
+        self.show(cx);
+    }
+    #[allow(
+        clippy::too_many_lines,
+        reason = "Keep action routing and its modal guards together"
+    )]
+    fn on_action(&mut self, cx: &mut Context, a: ActionId) {
+        if !self.ready {
+            if a == action_id("back") {
+                cx.exit();
+            }
+            return;
+        }
+        let is = |name: &str| a == action_id(name);
+        if self.exit_requested {
+            if is("cancel-exit") || is("back") {
+                self.exit_requested = false;
+            } else if is("save-progress") && self.storage_notice.is_some() && self.writable {
+                self.storage_notice = None;
+                self.flush(cx);
+            } else if is("exit-unsaved") && self.storage_notice.is_some() && !self.saving {
+                cx.exit();
+            }
+            self.show(cx);
+            return;
+        }
+        if is("storage-open") && self.storage_notice.is_some() {
+            self.storage_open = true;
+            self.show(cx);
+            return;
+        }
+        if is("storage-dismiss") || (is("back") && self.storage_open) {
+            self.storage_open = false;
+            self.show(cx);
+            return;
+        }
+        if self.leave.is_some() {
+            if is("confirm-leave") {
+                let target = self.leave.take().unwrap();
+                self.navigate(cx, target);
+            } else if is("cancel") || is("back") {
+                self.leave = None;
+            }
+            self.show(cx);
+            return;
+        }
+        if self.promotion.is_some() {
+            if is("cancel") || is("back") {
+                self.promotion = None;
+            } else {
+                for role in ['q', 'r', 'b', 'n'] {
+                    if is(&format!("promote-{role}")) {
+                        let base = self.promotion.take().unwrap();
+                        self.move_piece(cx, &format!("{base}{role}"));
+                        break;
+                    }
+                }
+            }
+            self.show(cx);
+            return;
+        }
+        if is("allow-sleep") && self.storage_notice.is_some() && !self.saving {
+            self.storage_waiver = true;
+            self.storage_open = false;
+        } else if is("exit") || (is("back") && self.page == Page::Home) {
+            self.request_exit(cx);
+        } else if is("save-progress") {
+            self.storage_open = false;
+            if self.writable {
+                self.storage_notice = None;
+                self.flush(cx);
+            } else {
+                self.ready = false;
+                cx.store().load(KEY);
+            }
+        } else if is("back") || is("home") {
+            self.request_leave(cx, Leave::Home);
+        } else if is("collections") {
+            self.page = Page::Collections;
+        } else if is("settings") {
+            self.page = Page::Settings;
+        } else if is("coordinates") {
+            self.progress.coordinates = !self.progress.coordinates;
+            self.save(cx);
+        } else if is("flip") {
+            self.progress.flipped = !self.progress.flipped;
+            self.save(cx);
+        } else if is("continue") || is("select-pack") {
+            if self.session.is_some() {
+                self.page = Page::Study;
+            } else {
+                self.start(cx, self.progress.current);
+            }
+        } else if self.page == Page::Study {
+            if is("next") || is("previous") {
+                let i = if is("next") {
+                    (self.progress.current + 1) % self.pack.len()
+                } else {
+                    (self.progress.current + self.pack.len() - 1) % self.pack.len()
+                };
+                self.request_leave(cx, Leave::Index(i));
+            } else if is("retry") {
+                let s = self.session.as_mut().unwrap();
+                s.retry();
+                self.progress.begin(s);
+                self.clear_selection();
+                self.feedback = "Fresh attempt. Earlier history is kept.".into();
+                self.save(cx);
+            } else if is("hint") {
+                let s = self.session.as_mut().unwrap();
+                let prior = s.hints;
+                if let Some(square) = s.hint() {
+                    self.selected = None;
+                    self.hint = Some(square.clone());
+                    self.feedback = format!("Hint: move the piece on {square}.");
+                    if prior == 0 {
+                        let record = self.progress.records.get_mut(&s.puzzle.id).unwrap();
+                        record.hints_used = record.hints_used.saturating_add(1);
+                        self.save(cx);
+                    }
+                }
+            } else if is("reveal") {
+                let s = self.session.as_mut().unwrap();
+                if s.complete() {
+                    self.show(cx);
+                    return;
+                }
+                s.reveal();
+                self.progress.finish(s);
+                self.clear_selection();
+                self.feedback = "Revealed. Retry to practice the line.".into();
+                self.save(cx);
+            } else if let Some(sq) = board::square_action(a) {
+                self.tap_square(cx, sq);
+            }
+        }
+        self.show(cx);
+    }
+    fn on_page_turn(&mut self, cx: &mut Context, forward: bool) {
+        if self.page == Page::Study {
+            self.on_action(cx, action_id(if forward { "next" } else { "previous" }));
+        }
+    }
+    fn on_load(&mut self, cx: &mut Context, key: &str, result: StoreResult) {
+        if key != KEY {
+            return;
+        }
+        if let StoreResult::Loaded { value, .. } = result {
+            let restored = value
+                .map(|bytes| Progress::decode(&bytes, &self.pack))
+                .transpose();
+            if let Ok(p) = restored {
+                self.progress = p.unwrap_or_else(|| Progress::new(&self.pack));
+                self.session = self.progress.restore(&self.pack).unwrap();
+                self.writable = true;
+                self.storage_notice = None;
+            } else {
+                self.writable = false;
+                self.storage_notice =
+                    Some("Progress damaged. Original preserved; study is read-only.".into());
+            }
+        } else {
+            self.writable = false;
+            self.storage_notice =
+                Some("Cannot read progress. Study is read-only; retry storage.".into());
+        }
+        // A storage retry can replace the active snapshot entirely. Always land
+        // on Home, so a missing session cannot leave Study without a board.
+        self.storage_open = self.storage_notice.is_some();
+        self.page = Page::Home;
+        self.clear_selection();
+        self.feedback.clear();
+        self.dirty = false;
+        self.saving = false;
+        self.storage_waiver = false;
+        self.exit_requested = false;
+        self.ready = true;
+        self.show(cx);
+    }
+    fn on_save(&mut self, cx: &mut Context, key: &str, result: StoreResult) {
+        if key != KEY {
+            return;
+        }
+        self.saving = false;
+        if matches!(result, StoreResult::Saved { .. }) {
+            self.storage_waiver = false;
+            self.flush(cx);
+            if self.exit_requested && !self.saving && !self.dirty {
+                cx.exit();
+            }
+        } else {
+            self.dirty = true;
+            self.storage_open = true;
+            self.storage_notice = Some("Progress not saved. Retry storage before leaving.".into());
+            self.show(cx);
+        }
+    }
+    fn can_suspend(&self) -> bool {
+        self.ready && (!self.writable || self.storage_waiver || (!self.saving && !self.dirty))
+    }
+    fn on_resume(&mut self, cx: &mut Context) {
+        self.last_screen = None;
+        self.show(cx);
+    }
+}
+fn main() -> std::process::ExitCode {
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() == 5 && args[1] == "--import-trainer" {
+        let result = args[4]
+            .split(',')
+            .map(|s| s.parse::<u32>().map_err(|e| e.to_string()))
+            .collect::<Result<Vec<_>, _>>()
+            .and_then(|ids| {
+                std::fs::File::open(&args[2])
+                    .map_err(|e| e.to_string())
+                    .and_then(pack::read_input)
+                    .and_then(|bytes| import::trainer(&bytes, &ids))
+            })
+            .and_then(|pack| std::fs::write(&args[3], pack).map_err(|e| e.to_string()));
+        return match result {
+            Ok(()) => {
+                println!("Validated private pack written locally; do not commit it.");
+                std::process::ExitCode::SUCCESS
+            }
+            Err(e) => {
+                eprintln!("Import failed: {e}");
+                std::process::ExitCode::FAILURE
+            }
+        };
+    }
+    if args.len() == 4 && args[1] == "--import-lichess" {
+        let result = std::fs::File::open(&args[2])
+            .map_err(|e| e.to_string())
+            .and_then(pack::read_input)
+            .and_then(|bytes| import::lichess(&bytes))
+            .and_then(|pack| std::fs::write(&args[3], pack).map_err(|e| e.to_string()));
+        return match result {
+            Ok(()) => {
+                println!("Validated selected pack written to {}", args[3]);
+                std::process::ExitCode::SUCCESS
+            }
+            Err(e) => {
+                eprintln!("Import failed: {e}");
+                std::process::ExitCode::FAILURE
+            }
+        };
+    }
+    if args.len() == 3 && args[1] == "--validate-pack" {
+        return match std::fs::File::open(&args[2])
+            .map_err(|e| e.to_string())
+            .and_then(pack::read_input)
+            .and_then(|bytes| String::from_utf8(bytes).map_err(|e| e.to_string()))
+            .and_then(Pack::parse)
+        {
+            Ok(pack) => {
+                println!(
+                    "Validated {} puzzles in {}",
+                    pack.len(),
+                    pack.header.collection_id
+                );
+                std::process::ExitCode::SUCCESS
+            }
+            Err(e) => {
+                eprintln!("Invalid pack: {e}");
+                std::process::ExitCode::FAILURE
+            }
+        };
+    }
+    if args.len() > 1 {
+        eprintln!("Usage: polgar-pocket [--validate-pack FILE | --import-lichess INPUT OUTPUT | --import-trainer INPUT OUTPUT IDS]");
+        return std::process::ExitCode::FAILURE;
+    }
+    let pack = Pack::parse(pack::BUILTIN.to_owned()).expect("bundled pack validated during tests");
+    match kobo_sdk::run("polgar-pocket", Pocket::new(pack)) {
+        Ok(()) => std::process::ExitCode::SUCCESS,
+        Err(e) => {
+            eprintln!("polgar-pocket: {e}");
+            std::process::ExitCode::FAILURE
+        }
+    }
+}
diff --git a/apps/polgar-pocket/src/pack.rs b/apps/polgar-pocket/src/pack.rs
new file mode 100644
index 00000000..530bcaa0
--- /dev/null
+++ b/apps/polgar-pocket/src/pack.rs
@@ -0,0 +1,159 @@
+//! JSON Lines: bounded header plus one independently decoded puzzle per line.
+use crate::rules;
+use serde::{Deserialize, Serialize};
+use shakmaty::Position;
+use std::{collections::BTreeSet, ops::Range};
+
+pub const BUILTIN: &str = include_str!("../packs/lichess-20.jsonl");
+const MAX_LINE: usize = 8192;
+const MAX_PACK: usize = 4 * 1024 * 1024;
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Header {
+    pub schema_version: u32,
+    pub collection_id: String,
+    pub title: String,
+    pub source: String,
+    pub license: String,
+}
+
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Puzzle {
+    pub id: String,
+    pub fen: String,
+    pub side_to_move: String,
+    pub solution: Vec<String>,
+    #[serde(default)]
+    pub explanation: String,
+    #[serde(default)]
+    pub difficulty: Option<u32>,
+    #[serde(default)]
+    pub tags: Vec<String>,
+    #[serde(default)]
+    pub source_url: Option<String>,
+}
+
+pub struct Pack {
+    pub header: Header,
+    data: String,
+    records: Vec<Range<usize>>,
+    ids: BTreeSet<String>,
+}
+
+fn identifier(s: &str) -> bool {
+    !s.is_empty()
+        && s.len() <= 96
+        && s.bytes()
+            .all(|c| c.is_ascii_alphanumeric() || b"-_.".contains(&c))
+}
+impl Puzzle {
+    pub fn validate(&self) -> Result<(), String> {
+        if !identifier(&self.id)
+            || self.fen.len() > 160
+            || self.explanation.chars().count() > 180
+            || self.solution.is_empty()
+            || self.solution.len() > 63
+            || self.solution.len() % 2 == 0
+            || self.tags.len() > 16
+            || self.tags.iter().any(|t| t.len() > 48)
+            || self.source_url.as_ref().is_some_and(|u| u.len() > 256)
+        {
+            return Err("Puzzle bounds or solution parity invalid".into());
+        }
+        let mut pos = rules::position(&self.fen)?;
+        let side = if pos.turn().is_white() {
+            "white"
+        } else {
+            "black"
+        };
+        if self.side_to_move != side {
+            return Err("Side does not match FEN".into());
+        }
+        for uci in &self.solution {
+            let movement = rules::movement(&pos, uci)?;
+            if movement
+                .to_uci(shakmaty::CastlingMode::Standard)
+                .to_string()
+                != *uci
+            {
+                return Err("Solution must use canonical standard UCI".into());
+            }
+            pos.play_unchecked(&movement);
+        }
+        Ok(())
+    }
+}
+impl Pack {
+    pub fn parse(data: String) -> Result<Self, String> {
+        if data.len() > MAX_PACK {
+            return Err("Pack exceeds 4 MiB".into());
+        }
+        let mut lines = data.split_inclusive('\n');
+        let first = lines.next().ok_or("Missing header")?;
+        if first.len() > MAX_LINE {
+            return Err("Header too large".into());
+        }
+        let header: Header = serde_json::from_str(first).map_err(|e| e.to_string())?;
+        if header.schema_version != 1
+            || !identifier(&header.collection_id)
+            || header.title.is_empty()
+            || header.title.chars().count() > 48
+            || header.source.len() > 512
+            || header.license.len() > 96
+        {
+            return Err("Incompatible pack header".into());
+        }
+        let mut offset = first.len();
+        let mut records = Vec::new();
+        let mut ids = BTreeSet::new();
+        for line in lines {
+            if line.len() > MAX_LINE || records.len() >= 4096 {
+                return Err("Pack bounds exceeded".into());
+            }
+            let puzzle: Puzzle = serde_json::from_str(line).map_err(|e| e.to_string())?;
+            puzzle
+                .validate()
+                .map_err(|e| format!("{}: {e}", puzzle.id))?;
+            if !ids.insert(puzzle.id) {
+                return Err("Duplicate puzzle ID".into());
+            }
+            records.push(offset..offset + line.len());
+            offset += line.len();
+        }
+        if records.is_empty() {
+            return Err("Empty pack".into());
+        }
+        Ok(Self {
+            header,
+            data,
+            records,
+            ids,
+        })
+    }
+    pub fn contains_id(&self, id: &str) -> bool {
+        self.ids.contains(id)
+    }
+    pub fn len(&self) -> usize {
+        self.records.len()
+    }
+    pub fn puzzle(&self, index: usize) -> Puzzle {
+        // Bytes and offsets are immutable after full validation.
+        serde_json::from_str(&self.data[self.records[index].clone()]).expect("validated pack")
+    }
+}
+
+/// Bound host import reads before allocation; a whole database is never needed.
+pub fn read_input(reader: impl std::io::Read) -> Result<Vec<u8>, String> {
+    use std::io::Read;
+    let mut bytes = Vec::new();
+    reader
+        .take((MAX_PACK + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|e| e.to_string())?;
+    if bytes.len() > MAX_PACK {
+        return Err("Input exceeds 4 MiB; select a subset".into());
+    }
+    Ok(bytes)
+}

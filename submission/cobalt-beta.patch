+fn lichess_import_applies_setup_and_preserves_ids() {
+    let data=br#"[{"puzzleId":"00sO1","fen":"1k1r4/pp3pp1/2p1p3/4b3/P3n1P1/8/KPP2PN1/3rBR1R b - - 2 31","moves":"b8c7 e1a5 b7b6 f1d1","rating":998,"themes":["discoveredAttack"]}]"#;
